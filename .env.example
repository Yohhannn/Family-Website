# Copy this file to .env and fill in your PostgreSQL connection details.

# Option A: one connection string (simplest)
DATABASE_URL=postgres://username:password@localhost:5432/lauglaug

# Option B (used only if DATABASE_URL is not set): individual pieces
# PGHOST=localhost
# PGPORT=5432
# PGUSER=username
# PGPASSWORD=password
# PGDATABASE=lauglaug

# Port the website itself runs on
PORT=3000
